{
  "name": "printbridge-relay",
  "version": "0.2.0",
  "description": "Cloudflare Workers + Durable Objects Cloud Relay for PrintBridge",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
